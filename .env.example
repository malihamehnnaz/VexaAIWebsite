# ─────────────────────────────────────────────────────────────────────────────
# Vexa AI Website — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and publishable (anon) key — safe to expose to the browser.
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service role key — NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
# Bypasses Row Level Security. Found in: Supabase dashboard → Project Settings → API → Secret keys
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Found in: Azure portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# The deployment name you created in Azure OpenAI Studio (e.g. gpt-4o, gpt-4.1)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# ── Resend (email) ────────────────────────────────────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# PRODUCTION: must use a verified domain, e.g. noreply@yourdomain.com
# DEV only:   onboarding@resend.dev works but has a 100 email/day sandbox limit
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Where contact form submissions are delivered
RESEND_TO_EMAIL=you@yourdomain.com
# Reply-to address shown to the person who submitted the form
RESEND_OWNER_REPLY_TO=you@yourdomain.com

# ── Admin panel ───────────────────────────────────────────────────────────────
# Password to access /admin. Use a strong random string (20+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_PANEL_PASSWORD=replace-with-strong-random-password

# Secret used to sign admin session tokens (HMAC-SHA256).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates all existing admin sessions.
SESSION_SECRET=replace-with-64-char-hex-secret

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Optional but strongly recommended in production.
# Without this, rate limiting uses in-memory storage that resets on cold starts.
# Free tier at: upstash.com → Create Database → copy REST URL and token
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Firebase / Firestore (chat & traffic logging) ─────────────────────────────
# Used for Firestore-based event logging alongside Supabase.
# If not set, Firestore logging is silently skipped (app still works).
# Found in: Firebase console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Facebook Messenger / Meta webhook ─────────────────────────────────────────
# Used by the /webhook route (Meta Developer Console → Messenger API Setup →
# Configure webhooks). Callback URL: https://YOUR-DOMAIN.com/webhook
#
# Verify token — you choose this value; enter the same value in Meta's webhook
# config so its verification GET request succeeds.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
META_VERIFY_TOKEN=your_secure_verification_token

# Optional but recommended in production — your Meta app's App Secret, used to
# verify the X-Hub-Signature-256 header on incoming webhook POSTs so forged
# requests are rejected. Without it, POST /webhook accepts any request body.
# Found in: Meta App Dashboard → App Settings → Basic → App Secret
META_APP_SECRET=your_meta_app_secret

# Page Access Token(s) — used by /api/messenger/reply to send messages back
# through Meta's Send API. One Page: set META_PAGE_ACCESS_TOKEN. Multiple
# Pages: set META_PAGE_ACCESS_TOKEN_<PAGE_ID> per Page — it's checked first,
# falling back to the generic one. Found in: Meta App Dashboard → Messenger →
# Messenger API Setup → Access Tokens (generate one per connected Page).
#   GP's - Guilty Pleasure Café → META_PAGE_ACCESS_TOKEN_106658601471856
#   Nitol Bot                  → META_PAGE_ACCESS_TOKEN_211548128717427
META_PAGE_ACCESS_TOKEN=your_page_access_token
# META_PAGE_ACCESS_TOKEN_106658601471856=token_for_gps_guilty_pleasure_cafe
# META_PAGE_ACCESS_TOKEN_211548128717427=token_for_nitol_bot

# Graph API version used for Send API calls. Optional — defaults to the
# current stable version in code (checked developers.facebook.com/docs/graph-api/changelog
# on 2026-09-05: v26.0). Only set this to pin to a specific version.
# META_GRAPH_API_VERSION=v26.0

# Bearer token the separate marketing website must send as
# `Authorization: Bearer <value>` to call /api/messenger/*.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MESSENGER_API_KEY=your_messenger_api_key

# Comma-separated list of origins allowed to call /api/messenger/* from a
# browser (CORS). No wildcard — only the marketing website's real origin(s).
# e.g. MESSENGER_ALLOWED_ORIGINS=https://marketing.example.com
MESSENGER_ALLOWED_ORIGINS=https://your-marketing-website.com

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to true to enable the fluid cursor visual effect
NEXT_PUBLIC_ENABLE_FLUID_CURSOR=false
